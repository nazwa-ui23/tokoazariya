<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Admin - AZARIYA</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        :root { --primary-green: #5a7862; --dark-green: #2d3e32; --light-green: #eaf0ec; --accent-green: #8cae96; --bg-color: #f7f9f7; --text-dark: #1a241c; --text-muted: #6b7c70; }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-dark); min-height: 100vh; display: flex; justify-content: center; align-items: center; padding: 20px; }
        .auth-card { background: #ffffff; border: 1px solid var(--light-green); padding: 30px 25px; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.08); width: 100%; max-width: 400px; text-align: center; }
        .auth-card h2 { color: var(--dark-green); margin-bottom: 8px; font-size: 1.5rem; }
        .auth-card p { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 20px; }
        .form-group { text-align: left; margin-bottom: 15px; }
        .form-group label { display: block; font-size: 0.8rem; font-weight: 600; color: var(--dark-green); margin-bottom: 6px; }
        .form-input { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; font-size: 0.9rem; outline: none; }
        .btn-auth { width: 100%; padding: 12px; background-color: var(--dark-green); color: #fff; border: none; border-radius: 8px; font-weight: bold; font-size: 0.9rem; cursor: pointer; margin-top: 10px; }
    </style>
</head>
<body>
    <div class="auth-card">
        <i class="fas fa-lock" style="font-size: 2.5rem; color: var(--primary-green); margin-bottom: 10px;"></i>
        <h2>Login Admin</h2>
        <p>Masukkan kata sandi khusus administrator</p>
        <form onsubmit="handleAdminLogin(event)">
            <div class="form-group">
                <label for="admin-username">Nama Pengguna (Username)</label>
                <input type="text" id="admin-username" class="form-input" placeholder="Masukkan username admin" required>
            </div>
            <div class="form-group">
                <label for="admin-password">Kata Sandi (Password)</label>
                <input type="password" id="admin-password" class="form-input" placeholder="••••••••" required>
            </div>
            <p id="admin-login-error" style="color: #e63946; font-size: 0.8rem; display: none; margin-bottom: 10px;">Username atau Kata Sandi salah!</p>
            <button type="submit" class="btn-auth">Masuk Admin <i class="fas fa-sign-in-alt"></i></button>
            <button type="button" class="btn-auth" style="background-color: var(--accent-green); margin-top: 8px;" onclick="location.href='index.html'">
                <i class="fas fa-arrow-left"></i> Kembali
            </button>
        </form>
    </div>
    <script>
        function handleAdminLogin(e) {
            e.preventDefault();
            const user = document.getElementById('admin-username').value;
            const pass = document.getElementById('admin-password').value;
            if (user === 'azariya' && pass === '54321') {
                location.href = 'admin_dashboard.html';
            } else {
                document.getElementById('admin-login-error').style.display = 'block';
            }
        }
    </script>
</body>
</html>
